  b0 -- "dispatch jobs to<br/>dispatch → jobs-in : jobs" --> b1
  b2 -- "lease sessions to<br/>lease → session-in : sessions" --> b1
  b2 -- "block [harmful]<br/>contention → wait-in : wait" --> b1
  b1 -- "retry against [harmful]<br/>retry → retry-in : retries" --> b2
  linkStyle 2 stroke:#c00,color:#c00,stroke-width:2px
