flowchart LR
  classDef tool fill:#d6e4f5,color:#111,stroke:#333
  classDef product fill:#d5ecd4,color:#111,stroke:#333,stroke-width:3px
  classDef mediator fill:#e8e8e8,color:#111,stroke:#333
  classDef environment fill:#f3f3f3,color:#111,stroke:#555,stroke-dasharray:5 3
  b0["Job scheduler<br/>«tool»"]:::tool
  b1["Batch worker<br/>«product»"]:::product
