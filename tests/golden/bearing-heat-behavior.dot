digraph function_model {
  graph [rankdir=LR, label="Motor shaft on a rolling-element bearing, with declared steady-state behaviour", labelloc=t];
  node [shape=record, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];
  "motor" [label="{Drive motor\n«tool»|{<o0> shaft-out (torque)}}"];
  "shaft" [label="{{<i0> drive (torque)|<i1> support (radial-load)|<i2> heat-in (heat)}|Shaft\n«product»|{<o0> expansion (preload)}}", penwidth=2];
  "bearing" [label="{{<i0> preload-in (preload)}|Ball bearing\n«mediator»|{<o0> race (radial-load)|<o1> friction (heat)}}"];
  "housing" [label="{Housing\n«mediator»|{<o0> bore (radial-load)}}"];
  "air" [label="{{<i0> sink (heat)}|Ambient air\n«environment»}", style="dashed", color="gray40"];
  "motor":o0:e -> "shaft":i0:w [label="rotate", color="black"];
  "bearing":o0:e -> "shaft":i1:w [label="support", color="black"];
  "bearing":o1:e -> "shaft":i2:w [label="heat [harmful]", color="red3", fontcolor="red3"];
  "shaft":o0:e -> "bearing":i0:w [label="overload [harmful]", color="red3", fontcolor="red3"];
}
