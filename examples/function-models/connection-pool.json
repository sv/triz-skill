{
  "domain": "software",
  "system": "Batch workers sharing a database connection pool (same wiring shape as bearing-heat; costs illustrative)",
  "carriers": [
    { "id": "jobs", "layer": "information", "dimension": "jobs dispatched/s" },
    { "id": "sessions", "layer": "information", "dimension": "DB sessions leased" },
    { "id": "wait", "layer": "temporal", "dimension": "ms lock wait" },
    { "id": "retries", "layer": "information", "dimension": "retried queries/s" }
  ],
  "boxes": [
    { "id": "scheduler", "name": "Job scheduler", "role": "tool", "action": "dispatch",
      "outputs": [{ "id": "dispatch", "carrier": "jobs" }], "cost": { "usd_month": 120 } },
    { "id": "worker", "name": "Batch worker", "role": "product",
      "inputs": [{ "id": "jobs-in", "carrier": "jobs" }, { "id": "session-in", "carrier": "sessions" }, { "id": "wait-in", "carrier": "wait" }],
      "outputs": [{ "id": "retry", "carrier": "retries" }] },
    { "id": "pool", "name": "Connection pool", "role": "mediator", "action": "lease",
      "inputs": [{ "id": "retry-in", "carrier": "retries" }],
      "outputs": [{ "id": "lease", "carrier": "sessions" }, { "id": "contention", "carrier": "wait" }],
      "cost": { "usd_month": 18, "oncall_h_month": 2 } },
    { "id": "database", "name": "Database (direct connections)", "role": "mediator", "action": "accept connections",
      "outputs": [{ "id": "connect", "carrier": "sessions" }], "cost": { "usd_month": 40 } },
    { "id": "tracing", "name": "Tracing backend", "role": "environment",
      "inputs": [{ "id": "spans", "carrier": "wait" }] }
  ],
  "wires": [
    { "id": "w-dispatch", "from": { "box": "scheduler", "port": "dispatch" }, "to": { "box": "worker", "port": "jobs-in" }, "carrier": "jobs", "polarity": "useful", "verb": "dispatch jobs to" },
    { "id": "w-lease", "from": { "box": "pool", "port": "lease" }, "to": { "box": "worker", "port": "session-in" }, "carrier": "sessions", "polarity": "useful", "verb": "lease sessions to" },
    { "id": "w-wait", "from": { "box": "pool", "port": "contention" }, "to": { "box": "worker", "port": "wait-in" }, "carrier": "wait", "polarity": "harmful", "verb": "block" },
    { "id": "w-retry", "from": { "box": "worker", "port": "retry" }, "to": { "box": "pool", "port": "retry-in" }, "carrier": "retries", "polarity": "harmful", "verb": "retry against" }
  ],
  "budget": { "usd_month": 200, "oncall_h_month": 4 },
  "contradictions": [
    {
      "id": "pool-size",
      "parameter": "connection pool size",
      "axes": { "time": ["cold-start", "warm-up", "steady"] },
      "demands": [
        { "id": "throughput", "values": ["large"], "because": "steady-state job throughput", "time": ["steady"] },
        { "id": "no-stampede", "values": ["small"], "because": "opening many connections at once overloads the database", "time": ["cold-start", "warm-up"] }
      ]
    }
  ]
}
