/-! ## The model as finite data -/

abbrev Box := Fin 4
abbrev Port := Fin 6
abbrev Fn := Fin 3
abbrev Carrier := Fin 4

def boxId : Box → String := !["source", "product", "component-box-0", "component-box-1"]
/-- Port ids are unique within their box (`portBox`). -/
def portId : Port → String := !["out", "in", "in", "out", "in", "out"]
def fnId : Fn → String := !["component-wire-0", "component-wire-1", "component-wire-2"]
def carrierId : Carrier → String := !["a", "b", "c", "d"]

def portBox : Port → Box := ![0, 1, 2, 2, 3, 3]
/-- `true` for an output port, `false` for an input port. -/
def portIsOutput : Port → Bool := ![true, false, false, true, false, true]
def portCarrier : Port → Carrier := ![0, 3, 1, 3, 0, 1]

/-- Every box and every function of the model; `out` and `inp` read the port tables. -/
def diagram : Wiring Box Port Fn Carrier where
  boxes := Set.univ
  wires := Set.univ
  src := ![(2, 3), (3, 5), (0, 0)]
  tgt := ![(1, 1), (2, 2), (3, 4)]
  carrier := ![3, 1, 0]
  out b p := if portBox p = b ∧ portIsOutput p = true then some (portCarrier p) else none
  inp b p := if portBox p = b ∧ portIsOutput p = false then some (portCarrier p) else none

def rating : Fn → Rating := ![.useful, .useful, .useful]

/-! ## Verdicts -/

/-- `checkModel`: every function runs from an output port to an input port, both of its carrier. -/
theorem typed : diagram.Typed :=
