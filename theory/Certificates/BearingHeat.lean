/-! ## The model as finite data -/

abbrev Box := Fin 5
abbrev Port := Fin 10
abbrev Fn := Fin 4
abbrev Carrier := Fin 4

def boxId : Box → String := !["motor", "shaft", "bearing", "housing", "air"]
/-- Port ids are unique within their box (`portBox`). -/
def portId : Port → String := !["shaft-out", "drive", "support", "heat-in", "expansion", "preload-in", "race", "friction", "bore", "sink"]
def fnId : Fn → String := !["w-drive", "w-support", "w-heat", "w-preload"]
def carrierId : Carrier → String := !["torque", "radial-load", "heat", "preload"]

def portBox : Port → Box := ![0, 1, 1, 1, 1, 2, 2, 2, 3, 4]
/-- `true` for an output port, `false` for an input port. -/
def portIsOutput : Port → Bool := ![true, false, false, false, true, false, true, true, true, false]
def portCarrier : Port → Carrier := ![0, 0, 1, 2, 3, 3, 1, 2, 1, 2]

/-- Every box and every function of the model; `out` and `inp` read the port tables. -/
def diagram : Wiring Box Port Fn Carrier where
  boxes := Set.univ
  wires := Set.univ
  src := ![(0, 0), (2, 6), (2, 7), (1, 4)]
  tgt := ![(1, 1), (1, 2), (1, 3), (2, 5)]
  carrier := ![0, 1, 2, 3]
  out b p := if portBox p = b ∧ portIsOutput p = true then some (portCarrier p) else none
  inp b p := if portBox p = b ∧ portIsOutput p = false then some (portCarrier p) else none

def rating : Fn → Rating := ![.useful, .useful, .harmful, .harmful]

/-! ## Verdicts -/

/-- `checkModel`: every function runs from an output port to an input port, both of its carrier. -/
theorem typed : diagram.Typed :=
  by intro w hw; clear hw; refine ⟨trivial, trivial, ?_⟩; revert w; decide +kernel

/-- `harmLoops` witness 0: the return path of function 2, from its object back to its performer. -/
theorem back_0 : Relation.ReflTransGen diagram.Acts (diagram.tgt 2).1 (diagram.src 2).1 :=
  show Relation.ReflTransGen diagram.Acts 1 2 from .head (b := 2) ⟨3, Set.mem_univ _, rfl, rfl⟩ <| .refl

/-- `harmLoops`: function 2 is harmful or excessive and lies on a closed loop (`edge_on_cycle`). -/
theorem loop_0 : (rating 2).Negative ∧ Relation.TransGen diagram.Acts (diagram.src 2).1 (diagram.src 2).1 :=
  ⟨by decide +kernel, edge_on_cycle ⟨2, Set.mem_univ _, rfl, rfl⟩ back_0⟩

/-- `harmLoops` witness 1: the return path of function 3, from its object back to its performer. -/
theorem back_1 : Relation.ReflTransGen diagram.Acts (diagram.tgt 3).1 (diagram.src 3).1 :=
  show Relation.ReflTransGen diagram.Acts 2 1 from .head (b := 1) ⟨1, Set.mem_univ _, rfl, rfl⟩ <| .refl

/-- `harmLoops`: function 3 is harmful or excessive and lies on a closed loop (`edge_on_cycle`). -/
theorem loop_1 : (rating 3).Negative ∧ Relation.TransGen diagram.Acts (diagram.src 3).1 (diagram.src 3).1 :=
  ⟨by decide +kernel, edge_on_cycle ⟨3, Set.mem_univ _, rfl, rfl⟩ back_1⟩

/-! ## Separation0: the contradiction named by `contradictionId` -/

namespace Separation0

def contradictionId : String := "clearance"
def parameter : String := "bearing internal clearance"
abbrev Demand := Fin 2
abbrev Val := Fin 2
def demandId : Demand → String := !["precision", "no-seizure"]
def valueId : Val → String := !["loose", "tight"]
def timeCell : Fin 3 → String := !["cold-start", "steady", "warm-up"]

/-- The base: one coordinate per axis with cells (time). -/
abbrev Cell := Fin 3
def valueTable : Demand → Val → Bool := ![![false, true], ![true, false]]
def timeTable : Demand → Fin 3 → Bool := ![![false, true, false], ![true, false, true]]
abbrev values (i : Demand) : Set Val := ofTable (valueTable i)
abbrev time (i : Demand) : Set (Fin 3) := ofTable (timeTable i)
/-- Where a demand applies: the product of its regions (an omitted axis is the whole axis). -/
abbrev support (i : Demand) : Set Cell := time i

/-- `separationCheck`: no single value meets every demand, so this is a physical contradiction. -/
theorem contradiction : ¬ ∃ v : Val, ∀ i, v ∈ values i :=
  by decide +kernel

/-- Demands 0 and 1 admit no common value. -/
theorem pair_0_1_values : Disjoint (values 0) (values 1) :=
  Set.disjoint_left.mpr (by decide +kernel)

/-- Axis time separates demands 0 and 1. -/
theorem pair_0_1_time : Disjoint (time 0) (time 1) :=
  Set.disjoint_left.mpr (by decide +kernel)

/-- `separationCheck`: demands 0 and 1 are separated (on time), so they glue (`glue_of_disjoint_regions`). -/
theorem pair_0_1 : ∃ s : Cell → Val, (∀ c ∈ support 0, s c ∈ values 0) ∧ (∀ c ∈ support 1, s c ∈ values 1) :=
  glue_of_disjoint_regions ⟨1, by decide +kernel⟩ ⟨0, by decide +kernel⟩ pair_0_1_time

/-- `separationCheck`: every cell's demands share a value, so the demands glue (`exists_section_iff`). -/
theorem gluable : ∃ s, IsSection support values s :=
  (exists_section_iff support values).mpr (by unfold admissible Set.Nonempty; decide +kernel)

end Separation0

