/-! ## The model as finite data -/

abbrev Box := Fin 5
abbrev Port := Fin 15
abbrev Fn := Fin 8
abbrev Carrier := Fin 5

def boxId : Box → String := !["client", "gateway", "app", "redis", "postgres"]
/-- Port ids are unique within their box (`portBox`). -/
def portId : Port → String := !["in", "out", "in", "fwd", "edge-cache", "req", "cache-in", "rows-in", "resp", "lookup", "memo", "get", "hit", "sql", "result"]
def fnId : Fn → String := !["w-call", "w-route", "w-serve", "w-lookup", "w-cache", "w-stale", "w-sql", "w-rows"]
def carrierId : Carrier → String := !["request", "response", "query", "cached", "rows"]

def portBox : Port → Box := ![0, 0, 1, 1, 1, 2, 2, 2, 2, 2, 2, 3, 3, 4, 4]
/-- `true` for an output port, `false` for an input port. -/
def portIsOutput : Port → Bool := ![false, true, false, true, true, false, false, false, true, true, true, false, true, false, true]
def portCarrier : Port → Carrier := ![1, 0, 0, 0, 3, 0, 3, 4, 1, 2, 3, 2, 3, 2, 4]

/-- Every box and every function of the model; `out` and `inp` read the port tables. -/
def diagram : Wiring Box Port Fn Carrier where
  boxes := Set.univ
  wires := Set.univ
  src := ![(0, 1), (1, 3), (2, 8), (2, 9), (3, 12), (3, 12), (2, 9), (4, 14)]
  tgt := ![(1, 2), (2, 5), (0, 0), (3, 11), (2, 6), (2, 6), (4, 13), (2, 7)]
  carrier := ![0, 0, 1, 2, 3, 3, 2, 4]
  out b p := if portBox p = b ∧ portIsOutput p = true then some (portCarrier p) else none
  inp b p := if portBox p = b ∧ portIsOutput p = false then some (portCarrier p) else none

def rating : Fn → Rating := ![.useful, .useful, .useful, .useful, .useful, .harmful, .useful, .useful]

/-! ## Verdicts -/

/-- `checkModel`: every function runs from an output port to an input port, both of its carrier. -/
theorem typed : diagram.Typed :=
  by intro w hw; clear hw; refine ⟨trivial, trivial, ?_⟩; revert w; decide +kernel

/-- `harmLoops` witness 0: the return path of function 5, from its object back to its performer. -/
theorem back_0 : Relation.ReflTransGen diagram.Acts (diagram.tgt 5).1 (diagram.src 5).1 :=
  show Relation.ReflTransGen diagram.Acts 2 3 from .head (b := 3) ⟨3, Set.mem_univ _, rfl, rfl⟩ <| .refl

/-- `harmLoops`: function 5 is harmful or excessive, its object reaches its performer, so a closed loop runs through it (`edge_on_cycle`). -/
theorem loop_0 : (rating 5).Negative ∧ Relation.ReflTransGen diagram.Acts (diagram.tgt 5).1 (diagram.src 5).1 ∧ Relation.TransGen diagram.Acts (diagram.src 5).1 (diagram.src 5).1 :=
  ⟨by decide +kernel, back_0, edge_on_cycle ⟨5, Set.mem_univ _, rfl, rfl⟩ back_0⟩

