{
  "$id": "https://github.com/sv/triz-skill/skills/triz-innovation/schemas/function-model.schema.json",
  "title": "FunctionModel",
  "description": "TRIZ function model as a typed open wiring diagram: boxes with typed ports, wires carrying one carrier and a polarity. Generated from src/act.ts; do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "enum": [
        "physical",
        "software",
        "business",
        "cyber-physical"
      ]
    },
    "system": {
      "type": "string"
    },
    "carriers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Carrier"
      }
    },
    "boxes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Box"
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Wire"
      }
    },
    "flows": {
      "description": "Flow paths: which boxes a carrier passes through, in order. Read by triz_flow and by merge's adjacent reading; the other checks ignore them",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Flow"
      }
    },
    "budget": {
      "description": "Resource limit per cost dimension",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "weights": {
      "description": "Explicit normalization to a scalar ideality: one weight per cost dimension plus 'harmful'",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)"
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhysicalContradiction"
      }
    }
  },
  "required": [
    "domain",
    "carriers",
    "boxes",
    "wires"
  ],
  "additionalProperties": false,
  "$defs": {
    "Carrier": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": [
            "material",
            "energy",
            "information",
            "financial",
            "legal",
            "temporal"
          ]
        },
        "dimension": {
          "type": "string",
          "minLength": 1,
          "description": "Unit, protocol, or measure carried, e.g. 'W thermal', 'gRPC request', 'USD/month'"
        },
        "values": {
          "description": "Finite set of values the carrier can take, e.g. ['low', 'high']; required on every port of a box that declares behavior",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "layer",
        "dimension"
      ],
      "additionalProperties": false
    },
    "Box": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "tool",
            "product",
            "mediator",
            "environment",
            "supersystem"
          ],
          "description": "Function-analysis role; environment and supersystem boxes are resources outside the engineered system"
        },
        "action": {
          "description": "Main action verb, e.g. 'support', 'route', 'monetize'",
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "cost": {
          "description": "Cost per resource dimension, e.g. { usd_month: 400, latency_ms: 2.5 }; dimensions are never summed together",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "behavior": {
          "description": "Declared behaviour: a finite relation from input-port values to output-port values over the carriers' declared values. An input tuple with no row cannot occur; several rows for one input tuple are alternatives. Omit when unknown",
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/BehaviorRow"
          }
        },
        "state": {
          "description": "Declared state: the finite set of values the box carries from one step to the next. Requires transition",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initial": {
          "description": "States the box may start in; a subset of state",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transition": {
          "description": "Declared dynamics: rows (state, inputs) → (next state, outputs) over the declared state and carrier values, making the box a nondeterministic Mealy machine. A (state, inputs) pair with no row cannot occur; several rows are alternatives. Requires state; a box declares behavior or transition, not both",
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransitionRow"
          }
        },
        "feasibility": {
          "description": "Monotone co-design feasibility: the minimal rows the box can work at, each a level provided per output port against the levels it requires per input port and its operating cost. Read monotonically: providing less never needs more, and more resources never hurt. No row may be dominated by another. A port has one level shared by every function on it, so additive sharing of a flow needs a splitter box. Omit when unknown",
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeasibilityRow"
          }
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within its box"
        },
        "carrier": {
          "type": "string",
          "minLength": 1,
          "description": "Carrier id"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "carrier"
      ],
      "additionalProperties": false
    },
    "BehaviorRow": {
      "type": "object",
      "properties": {
        "in": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Input port id → value; names every input port of the box"
        },
        "out": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Output port id → value; names every output port of the box"
        }
      },
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false,
      "description": "One admissible (inputs, outputs) pair of the box's relation"
    },
    "TransitionRow": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "description": "Current state; one of the box's declared state values"
        },
        "in": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Input port id → value; names every input port of the box"
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "description": "Next state; one of the box's declared state values"
        },
        "out": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Output port id → value; names every output port of the box"
        }
      },
      "required": [
        "state",
        "in",
        "next",
        "out"
      ],
      "additionalProperties": false,
      "description": "One admissible step of a stateful box: in this state, on these inputs, it may move to next and emit these outputs"
    },
    "FeasibilityRow": {
      "type": "object",
      "properties": {
        "provides": {
          "description": "Output port id → level the box can provide there, in the carrier's dimension; an omitted port provides nothing (level 0)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "requires": {
          "description": "Input port id → level the box needs there to provide this row; an omitted port needs nothing. Only a non-harmful function can supply it",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "cost": {
          "description": "Operating resources per cost dimension, added to the box's fixed cost; an omitted dimension needs nothing",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "description": "One minimal (functionality provided, resources required) pair of the box's monotone feasibility relation"
    },
    "Wire": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "description": "Output port of the box performing the function",
          "$ref": "#/$defs/Endpoint"
        },
        "to": {
          "description": "Input port of the box the function acts on",
          "$ref": "#/$defs/Endpoint"
        },
        "carrier": {
          "type": "string",
          "minLength": 1,
          "description": "Carrier id; must equal both port carriers"
        },
        "polarity": {
          "type": "string",
          "enum": [
            "useful",
            "insufficient",
            "excessive",
            "harmful"
          ],
          "description": "TRIZ function rating: useful at the right level, useful but insufficient, useful but excessive, or harmful"
        },
        "verb": {
          "description": "Function verb in base form, e.g. 'heat', 'cache', 'charge'",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "carrier",
        "polarity"
      ],
      "additionalProperties": false,
      "description": "A TRIZ function: a typed wire from an output port of the performing box to an input port of the box acted on"
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "box": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "box",
        "port"
      ],
      "additionalProperties": false
    },
    "Flow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "type": "string",
          "minLength": 1,
          "description": "Carrier id: what moves along the flow, e.g. water, a request, cash"
        },
        "path": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Box ids in the order the flow passes through them, in series. A box listed again later closes a loop; a box may not follow itself"
        },
        "medium": {
          "description": "The box that stands for what flows, when the boxes on the path act on it rather than pass it on, e.g. a 'water' or 'request' product box",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "carrier",
        "path"
      ],
      "additionalProperties": false,
      "description": "A flow path: the boxes a carrier passes through in series, in order. It records order along the flow, which functions do not: two boxes in series need not act on each other"
    },
    "PhysicalContradiction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "axes": {
          "description": "Declared cells per axis; defaults to the cells the demands name",
          "type": "object",
          "properties": {
            "space": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "time": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "condition": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "direction": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "level": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "demands": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Demand"
          }
        }
      },
      "required": [
        "id",
        "parameter",
        "demands"
      ],
      "additionalProperties": false
    },
    "Demand": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Admissible values of the parameter for this demand"
        },
        "because": {
          "description": "The outcome the demand protects",
          "type": "string"
        },
        "space": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "time": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "condition": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "direction": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "level": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "values"
      ],
      "additionalProperties": false,
      "description": "One requirement on the parameter; where a demand omits an axis it applies across that whole axis"
    }
  }
}
